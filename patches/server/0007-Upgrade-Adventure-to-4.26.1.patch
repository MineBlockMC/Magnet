diff --git a/src/test/java/io/papermc/paper/adventure/PaperAdventureJsonTest.java b/src/test/java/io/papermc/paper/adventure/PaperAdventureJsonTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..768c79524f1529c16317935ede8c3c799969ac0f
--- /dev/null
+++ b/src/test/java/io/papermc/paper/adventure/PaperAdventureJsonTest.java
@@ -0,0 +1,37 @@
+package io.papermc.paper.adventure;
+
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.event.ClickEvent;
+import net.kyori.adventure.text.event.HoverEvent;
+import net.kyori.adventure.text.format.TextColor;
+import org.junit.Test;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * 校验 PaperAdventure 的 JSON 序列化保持 1.16.5 格式。
+ */
+public class PaperAdventureJsonTest {
+
+    @Test
+    public void uses116JsonFormat() {
+        String click = PaperAdventure.GSON.serialize(Component.text("x").clickEvent(ClickEvent.runCommand("/magnet")));
+        assertTrue(click.contains("\"clickEvent\""));
+        assertFalse(click.contains("click_event"));
+
+        String hover = PaperAdventure.GSON.serialize(Component.text("x").hoverEvent(HoverEvent.showText(Component.text("tip"))));
+        assertTrue(hover.contains("\"hoverEvent\""));
+        assertFalse(hover.contains("hover_event"));
+    }
+
+    @Test
+    public void keepsRgbAndDownsampling() {
+        TextColor color = TextColor.color(0x123456);
+        String rgb = PaperAdventure.GSON.serialize(Component.text("x", color));
+        assertTrue(rgb.contains("#123456"));
+
+        String downsampled = PaperAdventure.COLOR_DOWNSAMPLING_GSON.serialize(Component.text("x", color));
+        assertFalse(downsampled.contains("#"));
+    }
+}
