Date: Wed, 7 Oct 2026 15:01:58 +0800
Subject: [PATCH] No default timings and verbose


diff --git a/src/main/java/com/destroystokyo/paper/PaperConfig.java b/src/main/java/com/destroystokyo/paper/PaperConfig.java
index e93fc1af8094173ecae944b610dc4fd5f986ee64..4a0ff488abf4fbe5b1394d510eb12228b37a88cf 100644
--- a/src/main/java/com/destroystokyo/paper/PaperConfig.java
+++ b/src/main/java/com/destroystokyo/paper/PaperConfig.java
@@ -182,8 +182,8 @@ public class PaperConfig {
     }
 
     private static void timings() {
-        boolean timings = getBoolean("timings.enabled", true);
-        boolean verboseTimings = getBoolean("timings.verbose", true);
+        boolean timings = getBoolean("timings.enabled", false); // Magnet
+        boolean verboseTimings = getBoolean("timings.verbose", false);
         TimingsManager.privacy = getBoolean("timings.server-name-privacy", false);
         TimingsManager.hiddenConfigs = getList("timings.hidden-config-entries", Lists.newArrayList("database", "settings.bungeecord-addresses"));
         int timingHistoryInterval = getInt("timings.history-interval", 300);
diff --git a/src/main/java/org/spigotmc/SpigotWorldConfig.java b/src/main/java/org/spigotmc/SpigotWorldConfig.java
index d58f1a8d5ea9d439ac51ce607cdad6fa63f49216..700e74b908209446035fa316bed0ed6c65af4d25 100644
--- a/src/main/java/org/spigotmc/SpigotWorldConfig.java
+++ b/src/main/java/org/spigotmc/SpigotWorldConfig.java
@@ -20,7 +20,7 @@ public class SpigotWorldConfig
 
     public void init()
     {
-        this.verbose = getBoolean( "verbose", true );
+        this.verbose = getBoolean( "verbose", false ); // Magnet
 
         log( "-------- World Settings For [" + worldName + "] --------" );
         SpigotConfig.readConfig( SpigotWorldConfig.class, this );
