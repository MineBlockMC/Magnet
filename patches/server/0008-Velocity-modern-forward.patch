 import java.util.List;
 import java.util.logging.Level;
 
@@ -119,4 +121,68 @@ public class MagnetConfig {
         ensureDefault(key, defaultValue, comment);
         return config.getStringList(key);
     }
+
+    public static boolean velocitySupportEnabled = false;
+    public static boolean velocitySupportOnlineMode = false;
+    /** Resolved forwarding secret: {@code settings.velocity-support.secret}, or the contents of the forwarding secret file. */
+    public static String velocitySecret = "";
+    private static String velocitySupportSecret = "";
+    private static String velocityForwardingSecretFile = "forwarding.secret";
+
+    private static void velocitySupport() {
+        velocitySupportEnabled = getBoolean("settings.velocity-support.enabled", velocitySupportEnabled, """
+                Whether to enable Velocity's modern player info forwarding.
+                EXPERIMENTAL - this is a backport of the protocol Paper added in 1.13. Requirements:
+                  - Velocity must use player-info-forwarding-mode = "modern" with the same secret.
+                  - This server MUST run with online-mode=false (Velocity authenticates players).
+                  - This server MUST have ViaVersion installed, or clients newer than 1.12.2 cannot connect.
+                  - Restrict this server's port to your proxy (firewall); the secret is the only authentication.
+                Set "verbose: true" at the top of this file to log details about the forwarding handshake.""");
+
+        velocitySupportOnlineMode = getBoolean("settings.velocity-support.online-mode", velocitySupportOnlineMode, """
+                Whether Velocity performs Mojang authentication for players.
+                Set this to true when your proxy runs with online-mode=true (recommended).""");
+
+        velocitySupportSecret = getString("settings.velocity-support.secret", velocitySupportSecret, """
+                The forwarding secret. Must match forwarding.secret on your Velocity proxy.
+                Leave this empty to read the secret from settings.velocity-support.forwarding-secret-file instead.""");
+
+        velocityForwardingSecretFile = getString("settings.velocity-support.forwarding-secret-file", velocityForwardingSecretFile, """
+                File to read the forwarding secret from when settings.velocity-support.secret is empty.""");
+
+        velocitySecret = resolveSecret(velocitySupportSecret, velocityForwardingSecretFile);
+
+        setComment("settings.velocity-support", "Velocity modern player info forwarding (EXPERIMENTAL).");
+
+        if (velocitySupportEnabled) {
+            if (velocitySecret.isEmpty()) {
+                logError("[Magnet] settings.velocity-support.enabled is true, but no forwarding secret was found."
+                        + " Set settings.velocity-support.secret or settings.velocity-support.forwarding-secret-file,"
+                        + " otherwise every login will be rejected.");
+            }
+
+            if (MinecraftServer.getServer().getOnlineMode()) {
+                Bukkit.getLogger().warning("[Magnet] Velocity modern forwarding will NOT be used because this server is running"
+                        + " with online-mode=true. Set online-mode=false in server.properties.");
+            }
+        }
+    }
+
+    private static String resolveSecret(String secret, String secretFile) {
+        if (secret != null && !secret.isEmpty()) {
+            return secret;
+        }
+
+        final File file = new File(secretFile);
+        if (!file.isFile()) {
+            return "";
+        }
+
+        try {
+            return new String(Files.readAllBytes(file.toPath()), StandardCharsets.UTF_8).trim();
+        } catch (IOException e) {
+            logError("[Magnet] Failed to read the Velocity forwarding secret from " + file.getAbsolutePath() + ": " + e.getMessage());
+            return "";
+        }
+    }
 }
diff --git a/src/main/java/org/mineblock/magnet/proxy/VelocityForwardingHandler.java b/src/main/java/org/mineblock/magnet/proxy/VelocityForwardingHandler.java
new file mode 100644
index 0000000000000000000000000000000000000000..dd7fb029c083f20df50b6c0bb21380132e3bace2
--- /dev/null
+++ b/src/main/java/org/mineblock/magnet/proxy/VelocityForwardingHandler.java
@@ -0,0 +1,131 @@
+package org.mineblock.magnet.proxy;
+
+import com.mojang.authlib.GameProfile;
+import io.netty.buffer.ByteBuf;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.ChannelInboundHandlerAdapter;
+import io.netty.util.ReferenceCountUtil;
+import net.minecraft.server.LoginListener;
+import net.minecraft.server.NetworkManager;
+import net.minecraft.server.PacketListener;
+import org.mineblock.magnet.MagnetConfig;
+
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.SocketAddress;
+
+/**
+ * Magnet - Velocity modern forwarding support.
+ * <p>
+ * Sits in the Netty pipeline right before the {@code decoder} (and therefore, because ViaVersion
+ * injects its own handlers later, right before {@code via-decoder}). It consumes the login plugin
+ * message answer that Velocity sends back, so ViaVersion never gets a chance to cancel it - which
+ * is exactly what would otherwise happen, since a 1.12.2 server has no packet to translate
+ * {@code ServerboundLoginPackets.CUSTOM_QUERY_ANSWER} onto.
+ * <p>
+ * Everything else is passed through untouched. Set {@code verbose: true} in {@code magnet.yml} to
+ * log what this handler sees; that is the intended way to diagnose a failing handshake.
+ */
+public class VelocityForwardingHandler extends ChannelInboundHandlerAdapter {
+
+    public static final String HANDLER_NAME = "magnet_velocity";
+    /** Packet id of the serverbound login plugin message in the LOGIN state (1.13+). */
+    private static final int LOGIN_PLUGIN_RESPONSE_PACKET_ID = 0x02;
+
+    private final NetworkManager networkManager;
+
+    public VelocityForwardingHandler(NetworkManager networkManager) {
+        this.networkManager = networkManager;
+    }
+
+    @Override
+    public void channelRead(ChannelHandlerContext ctx, Object msg) throws Exception {
+        if (!(msg instanceof ByteBuf)) {
+            super.channelRead(ctx, msg);
+            return;
+        }
+
+        final PacketListener packetListener = this.networkManager.i();
+        if (!(packetListener instanceof LoginListener)) {
+            super.channelRead(ctx, msg);
+            return;
+        }
+
+        final LoginListener loginListener = (LoginListener) packetListener;
+        final int expectedMessageId = loginListener.velocityLoginMessageId;
+        if (expectedMessageId == -1) {
+            super.channelRead(ctx, msg);
+            return;
+        }
+
+        final ByteBuf buf = (ByteBuf) msg;
+        final ByteBuf peek = buf.duplicate();
+        if (peek.readableBytes() < 1) {
+            super.channelRead(ctx, msg);
+            return;
+        }
+
+        final int peekedPacketId = VelocityProxy.readVarInt(peek);
+        if (peekedPacketId != LOGIN_PLUGIN_RESPONSE_PACKET_ID) {
+            MagnetConfig.log("[Magnet] Ignoring login packet 0x" + Integer.toHexString(peekedPacketId)
+                    + " while waiting for the Velocity answer");
+            super.channelRead(ctx, msg);
+            return;
+        }
+
+        InetSocketAddress clientAddress = null;
+        GameProfile profile = null;
+        String disconnectReason = null;
+
+        // Parse first, release afterwards: Netty's default checkAccessible makes any read on a
+        // released buffer throw IllegalReferenceCountException.
+        try {
+            MagnetConfig.log("[Magnet] Got a Velocity login plugin message (" + buf.readableBytes() + " bytes)");
+
+            VelocityProxy.readVarInt(buf); // packet id
+            final int messageId = VelocityProxy.readVarInt(buf);
+            final boolean success = buf.readBoolean();
+            MagnetConfig.log("[Magnet] Velocity answer: message id " + messageId + " (expected "
+                    + expectedMessageId + "), success=" + success);
+
+            if (messageId != expectedMessageId || !success) {
+                disconnectReason = "This server requires you to connect with Velocity.";
+            } else if (!VelocityProxy.checkIntegrity(buf)) {
+                disconnectReason = "Unable to verify player details";
+            } else {
+                final int version = VelocityProxy.readVarInt(buf);
+                MagnetConfig.log("[Magnet] Velocity forwarding data version " + version);
+
+                if (version > VelocityProxy.SUPPORTED_FORWARDING_VERSION) {
+                    disconnectReason = "Unsupported Velocity forwarding version " + version;
+                } else {
+                    final InetAddress address = VelocityProxy.readAddress(buf);
+                    final GameProfile forwardedProfile = VelocityProxy.createProfile(buf);
+
+                    final SocketAddress listening = this.networkManager.getSocketAddress();
+                    final int port = listening instanceof InetSocketAddress ? ((InetSocketAddress) listening).getPort() : 0;
+
+                    MagnetConfig.log("[Magnet] Forwarded player " + forwardedProfile.getName() + " ("
+                            + forwardedProfile.getId() + ") from " + address);
+
+                    clientAddress = new InetSocketAddress(address, port);
+                    profile = forwardedProfile;
+                }
+            }
+        } catch (Exception ex) {
+            MagnetConfig.log("[Magnet] Failed to read the Velocity login plugin message", ex);
+            disconnectReason = "Unable to verify player details";
+        } finally {
+            ReferenceCountUtil.release(buf);
+            if (ctx.pipeline().context(this) != null) {
+                ctx.pipeline().remove(this);
+            }
+        }
+
+        if (disconnectReason != null) {
+            loginListener.disconnect(disconnectReason);
+        } else {
+            loginListener.handleVelocityForwarding(clientAddress, profile);
+        }
+    }
+}
diff --git a/src/main/java/org/mineblock/magnet/proxy/VelocityProxy.java b/src/main/java/org/mineblock/magnet/proxy/VelocityProxy.java
new file mode 100644
index 0000000000000000000000000000000000000000..118a29a99d2eccd6cc029912a4b9f474056409a6
--- /dev/null
+++ b/src/main/java/org/mineblock/magnet/proxy/VelocityProxy.java
@@ -0,0 +1,189 @@
+package org.mineblock.magnet.proxy;
+
+import com.google.common.net.InetAddresses;
+import com.mojang.authlib.GameProfile;
+import com.mojang.authlib.properties.Property;
+import com.mojang.authlib.properties.PropertyMap;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.minecraft.server.NetworkManager;
+import org.mineblock.magnet.MagnetConfig;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+import java.net.InetAddress;
+import java.nio.charset.StandardCharsets;
+import java.security.InvalidKeyException;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.UUID;
+
+/**
+ * Backport of Paper's Velocity modern player info forwarding (added in 1.13) to 1.12.2.
+ * <p>
+ * Velocity's modern forwarding uses the 1.13 login plugin message packets, which do not exist in
+ * the 1.12.2 protocol. This implementation talks to the proxy with hand-built packets, and
+ * {@link VelocityForwardingHandler} consumes the answer before ViaVersion can cancel it.
+ * <p>
+ * The forwarding payload is {@code [32 byte HMAC-SHA256 signature][VarInt version]
+ * [String address][UUID][String name][properties]}.
+ */
+public class VelocityProxy {
+
+    /** Login plugin message channel Velocity answers on. */
+    public static final String CHANNEL = "velocity:player_info";
+    /** The only forwarding data version this server understands. */
+    public static final int SUPPORTED_FORWARDING_VERSION = 1;
+    /** Packet id of the clientbound login plugin message in the LOGIN state (1.13+). */
+    private static final int LOGIN_PLUGIN_REQUEST_PACKET_ID = 0x04;
+
+    /**
+     * Asks the proxy for the player's real details.
+     * <p>
+     * The packet is framed by hand and written straight into the pipeline from the interceptor's
+     * context. That skips the vanilla encoder (the packet id is not registered in the 1.12.2
+     * {@code EnumProtocol}) as well as ViaVersion's encoder, which would otherwise be handed a
+     * packet it cannot translate.
+     */
+    public static void sendLoginPluginRequest(NetworkManager networkManager, int messageId) {
+        final io.netty.channel.ChannelHandlerContext ctx =
+                networkManager.channel.pipeline().context(VelocityForwardingHandler.HANDLER_NAME);
+        if (ctx == null) {
+            MagnetConfig.logError("[Magnet] Unable to send the Velocity login plugin request: the interceptor is not in the pipeline.");
+            return;
+        }
+
+        MagnetConfig.log("[Magnet] Requesting player details from Velocity (message id " + messageId + ")");
+
+        final ByteBuf packet = Unpooled.buffer();
+        final ByteBuf frame = Unpooled.buffer();
+        try {
+            writeVarInt(packet, LOGIN_PLUGIN_REQUEST_PACKET_ID);
+            writeVarInt(packet, messageId);
+            writeString(packet, CHANNEL);
+            packet.writeByte(SUPPORTED_FORWARDING_VERSION);
+
+            writeVarInt(frame, packet.readableBytes());
+            frame.writeBytes(packet);
+
+            ctx.writeAndFlush(frame.retain());
+        } finally {
+            packet.release();
+            frame.release();
+        }
+    }
+
+    /**
+     * Verifies the HMAC-SHA256 signature at the start of {@code buf} and advances the reader index
+     * past it, leaving the forwarded data in the buffer.
+     */
+    public static boolean checkIntegrity(ByteBuf buf) {
+        final String secret = MagnetConfig.velocitySecret;
+        if (secret == null || secret.isEmpty()) {
+            MagnetConfig.log("[Magnet] No Velocity forwarding secret is configured, cannot verify the proxy");
+            return false;
+        }
+
+        if (buf.readableBytes() < 32) {
+            MagnetConfig.log("[Magnet] Velocity forwarding payload is too short (" + buf.readableBytes() + " bytes)");
+            return false;
+        }
+
+        final byte[] signature = new byte[32];
+        buf.readBytes(signature);
+
+        final byte[] data = new byte[buf.readableBytes()];
+        buf.getBytes(buf.readerIndex(), data);
+
+        try {
+            final Mac mac = Mac.getInstance("HmacSHA256");
+            mac.init(new SecretKeySpec(secret.getBytes(StandardCharsets.UTF_8), "HmacSHA256"));
+            final byte[] expected = mac.doFinal(data);
+            final boolean valid = MessageDigest.isEqual(signature, expected);
+            if (!valid) {
+                MagnetConfig.log("[Magnet] Velocity forwarding signature mismatch (secret length " + secret.length() + ")"
+                        + "\n  received: " + toHex(signature)
+                        + "\n  computed: " + toHex(expected)
+                        + "\n  payload : " + toHex(java.util.Arrays.copyOf(data, Math.min(data.length, 256)))
+                        + (data.length > 256 ? " ... (" + data.length + " bytes)" : ""));
+            }
+            return valid;
+        } catch (final InvalidKeyException | NoSuchAlgorithmException e) {
+            throw new AssertionError(e);
+        }
+    }
+
+    private static String toHex(byte[] bytes) {
+        final StringBuilder builder = new StringBuilder(bytes.length * 2);
+        for (byte b : bytes) {
+            builder.append(Character.forDigit(b >> 4 & 0xF, 16)).append(Character.forDigit(b & 0xF, 16));
+        }
+        return builder.toString();
+    }
+
+    public static InetAddress readAddress(ByteBuf buf) {
+        return InetAddresses.forString(readString(buf));
+    }
+
+    public static GameProfile createProfile(ByteBuf buf) {
+        final GameProfile profile = new GameProfile(readUuid(buf), readString(buf));
+        profile.getProperties().putAll(readProperties(buf));
+        return profile;
+    }
+
+    private static PropertyMap readProperties(ByteBuf buf) {
+        final PropertyMap properties = new PropertyMap();
+        final int count = readVarInt(buf);
+        for (int i = 0; i < count; i++) {
+            final String name = readString(buf);
+            final String value = readString(buf);
+            final String signature = buf.readBoolean() ? readString(buf) : null;
+            properties.put(name, new Property(name, value, signature));
+        }
+        return properties;
+    }
+
+    static int readVarInt(ByteBuf buf) {
+        int value = 0;
+        int position = 0;
+        byte current;
+        do {
+            current = buf.readByte();
+            value |= (current & 0x7F) << position;
+            position += 7;
+            if (position > 35) {
+                throw new IllegalArgumentException("VarInt is too big");
+            }
+        } while ((current & 0x80) != 0);
+        return value;
+    }
+
+    private static void writeVarInt(ByteBuf buf, int value) {
+        while ((value & ~0x7F) != 0) {
+            buf.writeByte(value & 0x7F | 0x80);
+            value >>>= 7;
+        }
+        buf.writeByte(value);
+    }
+
+    private static String readString(ByteBuf buf) {
+        final int length = readVarInt(buf);
+        if (length < 0 || length > buf.readableBytes()) {
+            throw new IllegalArgumentException("Bad string length " + length);
+        }
+
+        final String value = buf.toString(buf.readerIndex(), length, StandardCharsets.UTF_8);
+        buf.skipBytes(length);
+        return value;
+    }
+
+    private static void writeString(ByteBuf buf, String value) {
+        final byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        writeVarInt(buf, bytes.length);
+        buf.writeBytes(bytes);
+    }
+
+    private static UUID readUuid(ByteBuf buf) {
+        return new UUID(buf.readLong(), buf.readLong());
+    }
+}
