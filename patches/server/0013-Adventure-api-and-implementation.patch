@@ -0,0 +1,72 @@
+package org.mineblock.magnet.adventure;
+
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.event.ClickEvent;
+import net.kyori.adventure.text.event.HoverEvent;
+import net.kyori.adventure.text.format.TextColor;
+import net.kyori.adventure.text.minimessage.MiniMessage;
+import org.junit.Test;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class MagnetTextTest {
+
+    @Test
+    public void legacyTextIsParsedBeforeComponentCreation() {
+        Component component = MagnetText.fromLegacy("\u00a7cRed");
+        String plain = MagnetText.toPlain(component);
+        assertTrue(plain.equals("Red"));
+        assertFalse(plain.contains("\u00a7"));
+    }
+
+    @Test
+    public void rgbColorsAreDownsampled() {
+        Component component = Component.text("Red", TextColor.color(0xFF0000));
+        String json = MagnetText.toJson(component);
+        assertTrue(json.contains("\"color\":\"dark_red\""));
+        assertFalse(json.contains("#ff0000"));
+    }
+
+    @Test
+    public void legacyOutputDoesNotUseHexColors() {
+        Component component = Component.text("Red", TextColor.color(0xFF0000));
+        String legacy = MagnetText.toLegacy(component);
+        assertTrue(legacy.contains("\u00a74"));
+        assertFalse(legacy.contains("\u00a7x"));
+    }
+
+    @Test
+    public void hoverTextUsesLegacyFormat() {
+        Component component = Component.text("hover")
+                .hoverEvent(HoverEvent.showText(Component.text("tip")));
+        String json = MagnetText.toJson(component);
+        assertTrue(json.contains("\"value\""));
+        assertFalse(json.contains("\"contents\""));
+    }
+
+    @Test
+    public void sectionSignsAreRemovedBeforeSerialization() {
+        Component component = Component.text("\u00a7cRed");
+        assertFalse(MagnetText.toJson(component).contains("\u00a7"));
+        assertFalse(MagnetText.toPlain(component).contains("\u00a7"));
+        assertFalse(MagnetText.toAnsi(component).contains("\u00a7"));
+    }
+
+    @Test
+    public void translatableAndClickEventsSerialize() {
+        Component component = Component.translatable("chat.type.text")
+                .clickEvent(ClickEvent.runCommand("/magnet"));
+        String json = MagnetText.toJson(component);
+        assertTrue(json.contains("\"translate\":\"chat.type.text\""));
+        assertTrue(json.contains("\"run_command\""));
+    }
+
+    @Test
+    public void miniMessageCanBeParsedByPlugins() {
+        Component component = MiniMessage.miniMessage().deserialize("<red>Hello</red>");
+        String json = MagnetText.toJson(component);
+        assertTrue(json.contains("\"color\":\"red\""));
+        assertTrue(MagnetText.toPlain(component).equals("Hello"));
+    }
+}
