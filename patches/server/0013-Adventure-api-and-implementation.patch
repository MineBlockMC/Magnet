--- /dev/null
+++ b/src/main/java/org/mineblock/magnet/adventure/MagnetScheduler.java
@@ -0,0 +1,35 @@
+package org.mineblock.magnet.adventure;
+
+import net.minecraft.server.MinecraftServer;
+
+/**
+ * Adventure 功能使用的主线程调度工具。
+ */
+public final class MagnetScheduler {
+
+    /**
+     * 在主线程执行任务，若当前已在主线程则立即执行。
+     *
+     * @param task 任务
+     */
+    public static void runOnMainThread(Runnable task) {
+        MinecraftServer server = MinecraftServer.getServer();
+        if (server == null || server.isMainThread()) {
+            task.run();
+        } else {
+            server.postToMainThread(task);
+        }
+    }
+
+    /**
+     * 在下一 tick 的主线程执行任务。
+     *
+     * @param task 任务
+     */
+    public static void runNextTick(Runnable task) {
+        MinecraftServer.getServer().processQueue.add(task);
+    }
+
+    private MagnetScheduler() {
+    }
+}
