+import net.kyori.adventure.title.Title;
+import net.kyori.adventure.title.TitlePart;
+import net.minecraft.server.ChatComponentText;
+import net.minecraft.server.ChatMessageType;
+import net.minecraft.server.EntityPlayer;
+import net.minecraft.server.EnumHand;
+import net.minecraft.server.PacketPlayOutChat;
+import net.minecraft.server.PacketPlayOutPlayerListHeaderFooter;
+import net.minecraft.server.PacketPlayOutSetSlot;
+import net.minecraft.server.PacketPlayOutTitle;
+import net.minecraft.server.PlayerInventory;
+import org.bukkit.Location;
+import org.bukkit.Material;
+import org.bukkit.SoundCategory;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.craftbukkit.inventory.CraftItemStack;
+import org.bukkit.craftbukkit.inventory.CraftMetaBook;
+import org.bukkit.entity.Player;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.inventory.meta.BookMeta;
+import org.mineblock.magnet.MagnetConfig;
+
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * 玩家端的 Adventure 媒体实现。
+ */
+public final class MagnetPlayerAudience implements Audience {
+
+    private final Player player;
+    private final Map<BossBar, MagnetBossBar> bossBars = new IdentityHashMap<>();
+
+    /**
+     * 创建玩家组件入口。
+     *
+     * @param player 玩家
+     */
+    public MagnetPlayerAudience(Player player) {
+        this.player = player;
+    }
+
+    @Override
+    public void sendMessage(Component message) {
+        EntityPlayer handle = handle();
+        if (handle.playerConnection == null) {
+            return;
+        }
+        handle.playerConnection.sendPacket(new PacketPlayOutChat(MagnetComponents.toNms(message), ChatMessageType.SYSTEM));
+    }
+
+    @Override
+    public void sendActionBar(Component message) {
+        EntityPlayer handle = handle();
+        if (handle.playerConnection == null) {
+            return;
+        }
+        // 1.12.2 action bar 对 JSON 颜色支持不稳定，沿用 legacy 文本。
+        String legacy = MagnetText.toLegacy(message);
+        handle.playerConnection.sendPacket(new PacketPlayOutChat(new ChatComponentText(legacy), ChatMessageType.GAME_INFO));
+    }
+
+    @Override
+    public void sendPlayerListHeaderAndFooter(Component header, Component footer) {
+        EntityPlayer handle = handle();
+        if (handle.playerConnection == null) {
+            return;
+        }
+        handle.playerConnection.sendPacket(new PacketPlayOutPlayerListHeaderFooter(
+                MagnetComponents.toNms(header),
+                MagnetComponents.toNms(footer)
+        ));
+    }
+
+    @Override
+    public <T> void sendTitlePart(TitlePart<T> part, T value) {
+        EntityPlayer handle = handle();
+        if (handle.playerConnection == null) {
+            return;
+        }
+        if (part == TitlePart.TITLE) {
+            handle.playerConnection.sendPacket(new PacketPlayOutTitle(
+                    PacketPlayOutTitle.EnumTitleAction.TITLE,
+                    MagnetComponents.toNms((Component) value)
+            ));
+        } else if (part == TitlePart.SUBTITLE) {
+            handle.playerConnection.sendPacket(new PacketPlayOutTitle(
+                    PacketPlayOutTitle.EnumTitleAction.SUBTITLE,
+                    MagnetComponents.toNms((Component) value)
+            ));
+        } else if (part == TitlePart.TIMES) {
+            Title.Times times = (Title.Times) value;
+            handle.playerConnection.sendPacket(new PacketPlayOutTitle(
+                    PacketPlayOutTitle.EnumTitleAction.TIMES,
+                    (net.minecraft.server.IChatBaseComponent) null,
+                    ticks(times.fadeIn()),
+                    ticks(times.stay()),
+                    ticks(times.fadeOut())
+            ));
+        }
+    }
+
+    @Override
+    public void clearTitle() {
+        EntityPlayer handle = handle();
+        if (handle.playerConnection != null) {
+            handle.playerConnection.sendPacket(new PacketPlayOutTitle(PacketPlayOutTitle.EnumTitleAction.CLEAR, null));
+        }
+    }
+
+    @Override
+    public void resetTitle() {
+        EntityPlayer handle = handle();
+        if (handle.playerConnection != null) {
+            handle.playerConnection.sendPacket(new PacketPlayOutTitle(PacketPlayOutTitle.EnumTitleAction.RESET, null));
+        }
+    }
+
+    @Override
+    public void showBossBar(BossBar bar) {
+        bossBars.computeIfAbsent(bar, MagnetBossBar::new).add(handle());
+    }
+
+    @Override
+    public void hideBossBar(BossBar bar) {
+        MagnetBossBar bossBar = bossBars.remove(bar);
+        if (bossBar != null) {
+            bossBar.remove(handle());
+        }
+    }
+
+    @Override
+    public void playSound(Sound sound) {
+        playSound(sound, player.getLocation().getX(), player.getLocation().getY(), player.getLocation().getZ());
+    }
+
+    @Override
+    public void playSound(Sound sound, double x, double y, double z) {
+        player.playSound(
+                new Location(player.getWorld(), x, y, z),
+                sound.name().asString(),
+                toCategory(sound.source()),
+                sound.volume(),
+                sound.pitch()
+        );
+    }
+
+    @Override
+    public void playSound(Sound sound, Sound.Emitter emitter) {
+        playSound(sound);
+    }
+
+    @Override
+    public void stopSound(SoundStop stop) {
+        if (stop == null) {
+            return;
+        }
+        String sound = stop.sound() == null ? "" : stop.sound().asString();
+        player.stopSound(sound, toCategory(stop.source()));
+    }
+
+    @Override
+    public void sendResourcePacks(ResourcePackRequest request) {
+        List<ResourcePackInfo> packs = request.packs();
+        if (packs.isEmpty()) {
+            return;
+        }
+        ResourcePackInfo pack = packs.get(0);
+        player.setResourcePack(pack.uri().toString(), hashBytes(pack.hash()));
+        if (packs.size() > 1) {
+            MagnetConfig.log("[Magnet] 1.12.2 only supports one resource pack; ignored "
+                    + (packs.size() - 1) + " additional pack(s).");
+        }
+    }
+
+    @Override
+    public void openBook(Book book) {
+        MagnetScheduler.runOnMainThread(() -> openBookNow(book));
+    }
+
+    private void openBookNow(Book book) {
+        EntityPlayer handle = handle();
+        if (handle.playerConnection == null) {
+            return;
+        }
+
+        ItemStack item = new ItemStack(Material.WRITTEN_BOOK);
+        BookMeta meta = (BookMeta) item.getItemMeta();
+        if (meta == null) {
+            return;
+        }
+
+        meta.setTitle(plain(book.title(), 32));
+        meta.setAuthor(plain(book.author(), 32));
+        if (meta instanceof CraftMetaBook) {
+            CraftMetaBook craftMeta = (CraftMetaBook) meta;
+            craftMeta.pages.clear();
+            List<Component> pages = book.pages();
+            for (int i = 0; i < Math.min(pages.size(), 50); i++) {
+                craftMeta.pages.add(MagnetComponents.toNms(pages.get(i)));
+            }
+        }
+        item.setItemMeta(meta);
+
+        net.minecraft.server.ItemStack nmsBook = CraftItemStack.asNMSCopy(item);
+        PlayerInventory inventory = handle.inventory;
+        int slot = inventory.itemInHandIndex;
+        net.minecraft.server.ItemStack previous = inventory.getItem(slot);
+
+        inventory.setItem(slot, nmsBook);
+        handle.playerConnection.sendPacket(new PacketPlayOutSetSlot(0, 36 + slot, nmsBook));
+        handle.a(nmsBook, EnumHand.MAIN_HAND);
+
+        MagnetScheduler.runNextTick(() -> {
+            if (handle.playerConnection == null) {
+                return;
+            }
+            if (inventory.getItem(slot) == nmsBook) {
+                inventory.setItem(slot, previous);
+                handle.playerConnection.sendPacket(new PacketPlayOutSetSlot(0, 36 + slot, previous));
+            }
+        });
+    }
+
+    private EntityPlayer handle() {
+        return ((CraftPlayer) player).getHandle();
+    }
+
+    private static int ticks(java.time.Duration duration) {
+        return (int) (duration.toMillis() / 50L);
+    }
+
+    private static SoundCategory toCategory(Sound.Source source) {
+        if (source == null) {
+            return SoundCategory.MASTER;
+        }
+        try {
+            return SoundCategory.valueOf(source.name());
+        } catch (IllegalArgumentException ex) {
+            return SoundCategory.MASTER;
+        }
+    }
+
+    private static byte[] hashBytes(String hash) {
+        if (hash == null || hash.length() != 40) {
+            return null;
+        }
+        byte[] bytes = new byte[20];
+        for (int i = 0; i < bytes.length; i++) {
+            bytes[i] = (byte) Integer.parseInt(hash.substring(i * 2, i * 2 + 2), 16);
+        }
+        return bytes;
+    }
+
+    private static String plain(Component component, int maxLength) {
+        String text = MagnetText.toPlain(component).replace('\u00a7', ' ');
+        return text.length() > maxLength ? text.substring(0, maxLength) : text;
+    }
+}
