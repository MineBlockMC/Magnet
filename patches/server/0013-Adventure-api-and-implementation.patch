@@ -0,0 +1,30 @@
+package org.mineblock.magnet.adventure;
+
+import net.kyori.adventure.text.ComponentLike;
+import net.minecraft.server.ChatComponentText;
+import net.minecraft.server.IChatBaseComponent;
+import org.mineblock.magnet.MagnetConfig;
+
+/**
+ * Adventure 组件与 NMS 组件之间的转换。
+ */
+public final class MagnetComponents {
+
+    /**
+     * 把组件转换为 NMS 组件。
+     *
+     * @param component 组件
+     * @return NMS 组件
+     */
+    public static IChatBaseComponent toNms(ComponentLike component) {
+        try {
+            return IChatBaseComponent.ChatSerializer.a(MagnetText.toJson(component));
+        } catch (RuntimeException ex) {
+            MagnetConfig.logError("[Magnet] Failed to serialize Adventure component: " + ex.getMessage());
+            return new ChatComponentText(MagnetText.toPlain(component).replace('\u00a7', ' '));
+        }
+    }
+
+    private MagnetComponents() {
+    }
+}
diff --git a/src/main/java/org/mineblock/magnet/adventure/MagnetConsole.java b/src/main/java/org/mineblock/magnet/adventure/MagnetConsole.java
new file mode 100644
index 0000000000000000000000000000000000000000..7d8604923172b38279715098c17a34794d797131
--- /dev/null
+++ b/src/main/java/org/mineblock/magnet/adventure/MagnetConsole.java
@@ -0,0 +1,63 @@
+package org.mineblock.magnet.adventure;
+
+import net.minecrell.terminalconsole.TerminalConsoleAppender;
+import net.kyori.adventure.text.ComponentLike;
+import org.bukkit.Bukkit;
+import org.mineblock.magnet.MagnetConfig;
+
+/**
+ * 控制台 Adventure 组件输出。
+ */
+public final class MagnetConsole {
+
+    /**
+     * 渲染控制台文本，支持 ANSI 时使用真彩色，否则回退 legacy。
+     *
+     * @param component 组件
+     * @return 控制台文本
+     */
+    public static String render(ComponentLike component) {
+        if (MagnetConfig.isAdventureConsoleAnsi() && ansiSupported()) {
+            return MagnetText.toAnsi(component);
+        }
+        return MagnetText.toLegacy(component);
+    }
+
+    /**
+     * 输出信息级组件日志。
+     *
+     * @param component 组件
+     */
+    public static void info(ComponentLike component) {
+        Bukkit.getLogger().info(render(component));
+    }
+
+    /**
+     * 输出警告级组件日志。
+     *
+     * @param component 组件
+     */
+    public static void warn(ComponentLike component) {
+        Bukkit.getLogger().warning(render(component));
+    }
+
+    /**
+     * 输出错误级组件日志。
+     *
+     * @param component 组件
+     */
+    public static void error(ComponentLike component) {
+        Bukkit.getLogger().severe(render(component));
+    }
+
+    private static boolean ansiSupported() {
+        try {
+            return TerminalConsoleAppender.isAnsiSupported();
+        } catch (Throwable ignored) {
+            return false;
+        }
+    }
+
+    private MagnetConsole() {
+    }
+}
