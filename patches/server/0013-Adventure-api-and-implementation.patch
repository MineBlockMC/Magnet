+++ b/src/main/java/org/mineblock/magnet/adventure/MagnetBossBar.java
@@ -0,0 +1,91 @@
+package org.mineblock.magnet.adventure;
+
+import net.kyori.adventure.bossbar.BossBar;
+import net.kyori.adventure.text.Component;
+import net.minecraft.server.BossBattle;
+import net.minecraft.server.BossBattleServer;
+import net.minecraft.server.EntityPlayer;
+import net.minecraft.server.PacketPlayOutBoss;
+
+import java.util.Set;
+
+/**
+ * Adventure BossBar 的 1.12.2 实现。
+ */
+public final class MagnetBossBar implements BossBar.Listener {
+
+    private final BossBar bar;
+    private final BossBattleServer handle;
+
+    /**
+     * 创建 BossBar 包装。
+     *
+     * @param bar Adventure BossBar
+     */
+    public MagnetBossBar(BossBar bar) {
+        this.bar = bar;
+        this.handle = new BossBattleServer(
+                MagnetComponents.toNms(bar.name()),
+                BossBattle.BarColor.valueOf(bar.color().name()),
+                BossBattle.BarStyle.valueOf(bar.overlay().name())
+        );
+        updateFlags();
+        bar.addListener(this);
+    }
+
+    /**
+     * 让玩家看到此 BossBar。
+     *
+     * @param player 玩家
+     */
+    public void add(EntityPlayer player) {
+        handle.addPlayer(player);
+    }
+
+    /**
+     * 让玩家隐藏此 BossBar。
+     *
+     * @param player 玩家
+     */
+    public void remove(EntityPlayer player) {
+        handle.removePlayer(player);
+        if (handle.getPlayers().isEmpty()) {
+            bar.removeListener(this);
+        }
+    }
+
+    @Override
+    public void bossBarNameChanged(BossBar bar, Component oldName, Component newName) {
+        handle.title = MagnetComponents.toNms(newName);
+        handle.sendUpdate(PacketPlayOutBoss.Action.UPDATE_NAME);
+    }
+
+    @Override
+    public void bossBarProgressChanged(BossBar bar, float oldProgress, float newProgress) {
+        handle.setProgress(newProgress);
+    }
+
+    @Override
+    public void bossBarColorChanged(BossBar bar, BossBar.Color oldColor, BossBar.Color newColor) {
+        handle.color = BossBattle.BarColor.valueOf(newColor.name());
+        handle.sendUpdate(PacketPlayOutBoss.Action.UPDATE_STYLE);
+    }
+
+    @Override
+    public void bossBarOverlayChanged(BossBar bar, BossBar.Overlay oldOverlay, BossBar.Overlay newOverlay) {
+        handle.style = BossBattle.BarStyle.valueOf(newOverlay.name());
+        handle.sendUpdate(PacketPlayOutBoss.Action.UPDATE_STYLE);
+    }
+
+    @Override
+    public void bossBarFlagsChanged(BossBar bar, Set<BossBar.Flag> flagsAdded, Set<BossBar.Flag> flagsRemoved) {
+        updateFlags();
+        handle.sendUpdate(PacketPlayOutBoss.Action.UPDATE_PROPERTIES);
+    }
+
+    private void updateFlags() {
+        handle.setDarkenSky(bar.hasFlag(BossBar.Flag.DARKEN_SCREEN));
+        handle.setPlayMusic(bar.hasFlag(BossBar.Flag.PLAY_BOSS_MUSIC));
+        handle.setCreateFog(bar.hasFlag(BossBar.Flag.CREATE_WORLD_FOG));
+    }
+}
