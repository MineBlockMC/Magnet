+package org.bukkit.craftbukkit.inventory;
+
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.event.ClickEvent;
+import net.minecraft.server.NBTTagCompound;
+import org.junit.Test;
+
+import static org.junit.Assert.assertTrue;
+
+public class CraftMetaBookSignedAdventureTest {
+
+    @Test
+    public void writtenBookPagesKeepClickEvents() {
+        CraftMetaBookSigned meta = new CraftMetaBookSigned((CraftMetaItem) null);
+        meta.pages(Component.text("click").clickEvent(ClickEvent.runCommand("/magnet")));
+
+        NBTTagCompound tag = new NBTTagCompound();
