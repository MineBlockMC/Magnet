+// Magnet start
+import net.kyori.adventure.audience.Audience;
+import net.kyori.adventure.audience.ForwardingAudience;
+import net.kyori.adventure.text.ComponentLike;
+// Magnet end
 
 import com.google.common.collect.ImmutableList;
 import org.bukkit.advancement.Advancement;
@@ -1050,6 +1055,77 @@ public interface Server extends PluginMessageRecipient {
     Spigot spigot();
     // Spigot end
 
+    // Magnet start
+    /**
+     * 获取服务端级 Adventure 组件入口。
+     *
+     * @return 转发到控制台与在线玩家的组件入口
+     */
+    default Magnet magnet() {
+        return new Magnet(this);
+    }
+
+    /**
+     * 服务端级 Adventure 组件入口。
+     */
+    class Magnet implements ForwardingAudience {
+        private final Server server;
+
+        protected Magnet(Server server) {
+            this.server = server;
+        }
+
+        @Override
+        public Iterable<? extends Audience> audiences() {
+            java.util.List<Audience> audiences = new java.util.ArrayList<>();
+            audiences.add(server.getConsoleSender().magnet());
+            for (Player player : server.getOnlinePlayers()) {
+                audiences.add(player.magnet());
+            }
+            return audiences;
+        }
+
+        /**
+         * 依次向服务端所有 audience 发送组件或 Builder。
+         *
+         * @param messages 消息组件或 Builder
+         */
+        public void sendMessage(ComponentLike... messages) {
+            for (ComponentLike message : messages) {
+                sendMessage(message);
+            }
+        }
+
+        /**
+         * 向所有在线玩家广播组件消息。
+         *
+         * @param message 消息组件
+         * @return 接收人数
+         */
+        public int broadcast(ComponentLike message) {
+            return broadcast(message, Server.BROADCAST_CHANNEL_USERS);
+        }
+
+        /**
+         * 向具有指定权限的在线玩家广播组件消息。
+         *
+         * @param message 消息组件
+         * @param permission 所需权限
+         * @return 接收人数
+         */
+        public int broadcast(ComponentLike message, String permission) {
+            int count = 0;
+            for (Player player : server.getOnlinePlayers()) {
+                if (player.hasPermission(permission)) {
+                    player.magnet().sendMessage(message);
+                    count++;
+                }
+            }
+            return count;
+        }
+    }
+    // Magnet end
+
     void reloadPermissions(); // Paper
 
     boolean reloadCommandAliases(); // Paper
