+import net.kyori.adventure.text.serializer.gson.GsonComponentSerializer;
+import net.kyori.adventure.text.serializer.legacy.LegacyComponentSerializer;
+import net.kyori.adventure.text.serializer.plain.PlainTextComponentSerializer;
+// Magnet end
 
 public interface CommandSender extends Permissible {
 
@@ -59,6 +70,85 @@ public interface CommandSender extends Permissible {
     Spigot spigot();
     // Spigot end
 
+    // Magnet start
+    /**
+     * 获取 Adventure 组件发送入口。
+     *
+     * @return 绑定此发送者的组件入口
+     */
+    default Magnet magnet() {
+        return new Magnet(this);
+    }
+
+    /**
+     * 绑定到 {@link CommandSender} 的 Adventure 组件入口。
+     */
+    class Magnet implements Audience {
+        private static final GsonComponentSerializer JSON = GsonComponentSerializer.colorDownsamplingGson();
+        private static final LegacyComponentSerializer LEGACY = LegacyComponentSerializer.legacySection();
+
+        protected final CommandSender sender;
+
+        protected Magnet(CommandSender sender) {
+            this.sender = sender;
+        }
+
+        /**
+         * 以 Adventure 组件形式发送消息。
+         *
+         * @param message 消息组件
+         */
+        @Override
+        public void sendMessage(Component message) {
+            sender.sendMessage(toLegacy(withoutLegacyFormatting(message)));
+        }
+
+        @Override
+        public void sendMessage(ComponentLike message) {
+            sendMessage(message.asComponent());
+        }
+
+        /**
+         * 依次发送多个 Adventure 组件或 Builder。
+         *
+         * @param messages 消息组件或 Builder
+         */
+        public void sendMessage(ComponentLike... messages) {
+            for (ComponentLike message : messages) {
+                sendMessage(message.asComponent());
+            }
+        }
+
+        @Override
+        public void sendMessage(Component message, ChatType.Bound boundChatType) {
+            sendMessage(message);
+        }
+
+        @Override
+        public void sendMessage(ComponentLike message, ChatType.Bound boundChatType) {
+            sendMessage(message.asComponent());
+        }
+
+        @Override
+        public void sendMessage(SignedMessage signedMessage, ChatType.Bound boundChatType) {
+            Component content = signedMessage.unsignedContent();
+            sendMessage(content == null ? Component.text(signedMessage.message()) : content);
+        }
+
+        private static Component withoutLegacyFormatting(Component message) {
+            return message.replaceText(TextReplacementConfig.builder().matchLiteral("\u00a7").replacement("").build());
+        }
+
+        private static String toLegacy(Component message) {
+            try {
+                return LEGACY.serialize(JSON.deserialize(JSON.serialize(message)));
+            } catch (RuntimeException ex) {
+                return LEGACY.serialize(Component.text(PlainTextComponentSerializer.plainText().serialize(message)));
+            }
+        }
+    }
+    // Magnet end
+
     // Paper start
     /**
      * Sends the component to the sender
