diff --git a/src/main/java/org/mineblock/magnet/adventure/MagnetText.java b/src/main/java/org/mineblock/magnet/adventure/MagnetText.java
new file mode 100644
index 0000000000000000000000000000000000000000..f9b4be8429f238a1dff289310caaf533af69dfdf
--- /dev/null
+++ b/src/main/java/org/mineblock/magnet/adventure/MagnetText.java
@@ -0,0 +1,85 @@
+package org.mineblock.magnet.adventure;
+
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.ComponentLike;
+import net.kyori.adventure.text.TextReplacementConfig;
+import net.kyori.adventure.text.serializer.ansi.ANSIComponentSerializer;
+import net.kyori.adventure.text.serializer.gson.GsonComponentSerializer;
+import net.kyori.adventure.text.serializer.legacy.LegacyComponentSerializer;
+import net.kyori.adventure.text.serializer.plain.PlainTextComponentSerializer;
+
+/**
+ * Adventure 组件与 1.12.2 文本格式之间的转换。
+ */
+public final class MagnetText {
+
+    private static final GsonComponentSerializer JSON = GsonComponentSerializer.colorDownsamplingGson();
+    private static final LegacyComponentSerializer LEGACY = LegacyComponentSerializer.legacySection();
+    private static final PlainTextComponentSerializer PLAIN = PlainTextComponentSerializer.plainText();
+    private static final ANSIComponentSerializer ANSI = ANSIComponentSerializer.ansi();
+
+    /**
+     * 序列化为 1.12.2 客户端可解析的 JSON。
+     *
+     * @param component 组件
+     * @return JSON 文本
+     */
+    public static String toJson(ComponentLike component) {
+        return JSON.serialize(withoutLegacyFormatting(component.asComponent()));
+    }
+
+    /**
+     * 转换为 legacy 文本，颜色会先下调到命名颜色。
+     *
+     * @param component 组件
+     * @return legacy 文本
+     */
+    public static String toLegacy(ComponentLike component) {
+        try {
+            return LEGACY.serialize(JSON.deserialize(toJson(component)));
+        } catch (RuntimeException ex) {
+            return LEGACY.serialize(Component.text(toPlain(component).replace('\u00a7', ' ')));
+        }
+    }
+
+    /**
+     * 转换为纯文本。
+     *
+     * @param component 组件
+     * @return 纯文本
+     */
+    public static String toPlain(ComponentLike component) {
+        return PLAIN.serialize(withoutLegacyFormatting(component.asComponent()));
+    }
+
+    /**
+     * 转换为 ANSI 文本。
+     *
+     * @param component 组件
+     * @return ANSI 文本
+     */
+    public static String toAnsi(ComponentLike component) {
+        try {
+            return ANSI.serialize(withoutLegacyFormatting(component.asComponent()));
+        } catch (RuntimeException ex) {
+            return toLegacy(component);
+        }
+    }
+
+    /**
+     * 解析 legacy 文本。
+     *
+     * @param text legacy 文本
+     * @return 组件
+     */
+    public static Component fromLegacy(String text) {
+        return text == null ? Component.empty() : LEGACY.deserialize(text);
+    }
+
+    private static Component withoutLegacyFormatting(Component component) {
+        return component.replaceText(TextReplacementConfig.builder().matchLiteral("\u00a7").replacement("").build());
+    }
+
+    private MagnetText() {
+    }
+}
diff --git a/src/test/java/org/bukkit/ServerAdventureTest.java b/src/test/java/org/bukkit/ServerAdventureTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..48483ebe025846e2f4b1d244d783692e31ecfbaf
--- /dev/null
+++ b/src/test/java/org/bukkit/ServerAdventureTest.java
@@ -0,0 +1,39 @@
+package org.bukkit;
+
+import net.kyori.adventure.text.Component;
+import org.junit.Test;
+
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.Assert.assertEquals;
+
+public class ServerAdventureTest {
+
+    @Test
+    public void broadcastAcceptsComponentLike() {
+        List<Component> messages = new ArrayList<>();
+        Server server = (Server) Proxy.newProxyInstance(
+                Server.class.getClassLoader(),
+                new Class<?>[]{Server.class},
+                (proxy, method, args) -> {
+                    if (method.isDefault()) {
+                        return InvocationHandler.invokeDefault(proxy, method, args);
+                    }
+                    if (method.getName().equals("broadcast") && args != null && args.length == 2 && args[0] instanceof Component) {
+                        messages.add((Component) args[0]);
+                        return 1;
+                    }
+                    return null;
+                });
+
+        assertEquals(1, server.broadcast(Component.text("first").toBuilder()));
+        assertEquals(1, server.broadcast(Component.text("second").toBuilder(), "magnet.test"));
+
+        assertEquals(2, messages.size());
+        assertEquals(Component.text("first"), messages.get(0));
+        assertEquals(Component.text("second"), messages.get(1));
+    }
+}
