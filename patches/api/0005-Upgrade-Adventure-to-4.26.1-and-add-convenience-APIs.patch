     boolean hasDestroyableKeys();
     // Paper end
+    // Magnet start
+    /**
+     * 设置物品显示名；传入 null 清除。
+     *
+     * @param name 显示名组件或 Builder
+     */
+    default void displayName(@Nullable net.kyori.adventure.text.ComponentLike name) {
+        displayName(name == null ? null : name.asComponent());
+    }
+
+    /**
+     * 设置物品 lore；传入 null 清除。
+     *
+     * @param lines lore 行
+     */
+    default void lore(@Nullable net.kyori.adventure.text.ComponentLike... lines) {
+        if (lines == null) {
+            lore((List<net.kyori.adventure.text.Component>) null);
+            return;
+        }
+        List<net.kyori.adventure.text.Component> components = new java.util.ArrayList<>(lines.length);
+        for (net.kyori.adventure.text.ComponentLike line : lines) {
+            components.add(line == null ? net.kyori.adventure.text.Component.empty() : line.asComponent());
+        }
+        lore(components);
+    }
+
+    /**
+     * 清除物品 lore。
+     */
+    default void clearLore() {
+        lore((List<net.kyori.adventure.text.Component>) null);
+    }
+    // Magnet end
 }
diff --git a/src/main/java/org/mineblock/magnet/adventure/MagnetText.java b/src/main/java/org/mineblock/magnet/adventure/MagnetText.java
new file mode 100644
index 0000000000000000000000000000000000000000..5851a1b86af04e9470ac4d2b50c5d36317a1203b
--- /dev/null
+++ b/src/main/java/org/mineblock/magnet/adventure/MagnetText.java
@@ -0,0 +1,74 @@
+package org.mineblock.magnet.adventure;
+
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.ComponentLike;
+import net.kyori.adventure.text.TextReplacementConfig;
+import net.kyori.adventure.text.serializer.gson.GsonComponentSerializer;
+import net.kyori.adventure.text.serializer.json.JSONOptions;
+import net.kyori.adventure.text.serializer.legacy.LegacyComponentSerializer;
+import net.kyori.adventure.text.serializer.plain.PlainTextComponentSerializer;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * Adventure 组件与 1.16.5 文本格式之间的转换。
+ */
+public final class MagnetText {
+
+    // 1.16.5 数据版本，确保输出 clickEvent/hoverEvent 而非 1.21 的 snake_case。
+    private static final GsonComponentSerializer JSON = GsonComponentSerializer.builder()
+            .options(JSONOptions.byDataVersion().at(2586))
+            .build();
+    private static final LegacyComponentSerializer LEGACY = LegacyComponentSerializer.builder()
+            .hexColors()
+            .useUnusualXRepeatedCharacterHexFormat()
+            .build();
+    private static final PlainTextComponentSerializer PLAIN = PlainTextComponentSerializer.plainText();
+
+    /**
+     * 序列化为 1.16.5 客户端可解析的 JSON。
+     *
+     * @param component 组件
+     * @return JSON 文本
+     */
+    public static @NotNull String toJson(@NotNull ComponentLike component) {
+        return JSON.serialize(withoutLegacyFormatting(component.asComponent()));
+    }
+
+    /**
+     * 转换为 legacy 文本。
+     *
+     * @param component 组件
+     * @return legacy 文本
+     */
+    public static @NotNull String toLegacy(@NotNull ComponentLike component) {
+        return LEGACY.serialize(withoutLegacyFormatting(component.asComponent()));
+    }
+
+    /**
+     * 转换为纯文本。
+     *
+     * @param component 组件
+     * @return 纯文本
+     */
+    public static @NotNull String toPlain(@NotNull ComponentLike component) {
+        return PLAIN.serialize(withoutLegacyFormatting(component.asComponent()));
+    }
+
+    /**
+     * 解析 legacy 文本。
+     *
+     * @param text legacy 文本
+     * @return 组件
+     */
+    public static @NotNull Component fromLegacy(@Nullable String text) {
+        return text == null ? Component.empty() : LEGACY.deserialize(text);
+    }
+
+    private static Component withoutLegacyFormatting(Component component) {
+        return component.replaceText(TextReplacementConfig.builder().matchLiteral("\u00a7").replacement("").build());
+    }
+
+    private MagnetText() {
+    }
+}
