-            return;
+    // Magnet start
+    @NotNull
+    private File checkUpdate(@NotNull File file) throws InvalidPluginException {
+        if (updateDirectory == null || !updateDirectory.isDirectory() || !file.isFile()) {
+            return file;
+        }
+
+        try {
+            String pluginName = getPluginName(file);
+            if (pluginName == null) {
+                return file;
+            }
+
+            File updateFile = findUpdateFileByPluginName(pluginName, file);
+            if (updateFile == null) {
+                return file;
+            }
+
+            Files.copy(updateFile.toPath(), file.toPath(), StandardCopyOption.REPLACE_EXISTING);
+            File renamedFile = new File(file.getParentFile(), updateFile.getName());
+            if (!renamedFile.equals(file)) {
+                Files.move(file.toPath(), renamedFile.toPath(), StandardCopyOption.REPLACE_EXISTING);
+            }
+            Files.delete(updateFile.toPath());
+            return renamedFile;
+        } catch (Exception ex) {
+            throw new InvalidPluginException(ex);
+        }
+    }
+
+    @Nullable
+    private File findUpdateFileByPluginName(@NotNull String pluginName, @NotNull File file) {
+        File[] updateFiles = updateDirectory.listFiles();
+        if (updateFiles == null) {
+            return null;
         }
 
-        File updateFile = new File(updateDirectory, file.getName());
-        if (updateFile.isFile() && FileUtil.copy(updateFile, file)) {
-            updateFile.delete();
+        for (File updateFile : updateFiles) {
+            if (!updateFile.isFile() || updateFile.equals(file)) {
+                continue;
+            }
+
+            try {
+                if (pluginName.equals(getPluginName(updateFile))) {
+                    return updateFile;
+                }
+            } catch (InvalidDescriptionException ex) {
+                // 跳过无法解析的 jar，不影响其他候选文件。
+            }
         }
+
+        return null;
+    }
+
+    @Nullable
+    private String getPluginName(@NotNull File file) throws InvalidDescriptionException {
+        for (Map.Entry<Pattern, PluginLoader> entry : fileAssociations.entrySet()) {
+            if (entry.getKey().matcher(file.getName()).find()) {
+                return entry.getValue().getPluginDescription(file).getName();
+            }
+        }
+
+        return null;
     }
